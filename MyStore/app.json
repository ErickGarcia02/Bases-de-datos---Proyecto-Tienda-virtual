{
  "expo": {
    "name": "MyStore",
    "slug": "MyStore",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo.png",
    "userInterfaceStyle": "light",

    "ios": {
      "supportsTablet": true
    },

    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.MyStore"
    },

    "web": {
      "favicon": "./assets/logo.png"
    },

    "plugins": [
      "expo-font",
      "@react-native-community/datetimepicker",
      "expo-splash-screen",
      "expo-status-bar"
    ],

    "extra": {
      "eas": {
        "projectId": "572410fd-2237-4015-a567-d89a15be8deb"
      }
    }
  }
}